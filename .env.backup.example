# S3-compatible storage configuration for database backup sidecar
# Copy this file to .env.backup and fill in the required values

# Required: S3 bucket name
S3_BUCKET=your-backup-bucket
# Required: S3 access key ID
S3_ACCESS_KEY=your-access-key
# Required: S3 secret access key
S3_SECRET_KEY=your-secret-key

# Optional: S3-compatible endpoint URL (e.g., https://s3.amazonaws.com, https://minio.example.com)
# Leave commented for AWS S3
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# Optional: S3 key prefix for backup files (default: backups/)
# S3_PREFIX=backups/
# Optional: AWS region (default: us-east-1)
# S3_REGION=us-east-1

# Optional: Backup interval in seconds (default: 86400 = 24 hours)
# BACKUP_INTERVAL=86400
# Optional: Number of backup copies to retain (default: 7)
# BACKUP_RETENTION=7
# Optional: Backup mode — "scheduled" (continuous) or "once" (single run and exit)
# BACKUP_MODE=scheduled

# Optional: Path to SQLite database file (default: data/exchange_rates.db)
# Must match the DB_PATH in the main bot .env file
# DB_PATH=data/exchange_rates.db
# Optional: Log level (default: INFO)
# LOG_LEVEL=INFO
